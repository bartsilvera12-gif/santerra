# ============================================================
# Santerra — configuracion de Apache para Hostinger
#
# El sitio es un export estatico de Next con trailingSlash: true, o sea
# que cada ruta es una carpeta con su index.html:
#   /propiedades/           -> propiedades/index.html
#   /propiedades/casa-x/    -> propiedades/casa-x/index.html
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Forzar https (Hostinger termina el TLS antes de Apache) ---
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- El resolvedor de Google Maps es PHP, no tocarlo ---
  RewriteRule ^api/ - [L]

  # --- Archivos y carpetas que existen se sirven tal cual ---
  # Para las carpetas, del index.html se encarga DirectoryIndex.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- /ruta  ->  /ruta/  cuando existe la carpeta con su index.html ---
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # --- Propiedad sin pagina generada ---
  # Las cargadas despues de la ultima publicacion no tienen carpeta propia.
  # En vez de un 404, se resuelven por id en /propiedades/detalle/.
  RewriteRule ^propiedades/([^/]+)/?$ /propiedades/detalle/?id=$1 [L,QSA]

  # --- Cualquier otra cosa: el 404 propio del sitio ---
  RewriteRule ^ /404.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ------------------------------------------------------------
# Compresion
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
# Cache
# Los assets de Next llevan hash en el nombre, asi que se pueden cachear
# para siempre. El HTML no, porque cambia con cada publicacion.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ------------------------------------------------------------
# No servir archivos sensibles
# ------------------------------------------------------------
<FilesMatch "^\.env|^\.git|\.map$">
  Require all denied
</FilesMatch>
